@model Artista
@{
    var action = (string)ViewContext.RouteData.Values["action"]!;
    var isEdit = action.Equals("Edit", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = isEdit ? "Editar artista" : "Nuevo artista";
}
<h2>@ViewData["Title"]</h2>

<form asp-action="@action" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <!-- Foto de portada -->
    <div class="mb-3">
        <img src="@Model.UrlFotoPortada" class="img-fluid w-100" alt="Foto de portada" />
    </div>

    <div class="d-flex mb-3">
        <!-- Foto de perfil -->
        <div>
            <img src="@Model.UrlFotoPerfil" class="rounded-circle" style="width: 150px; height: 150px; object-fit: cover;" alt="Foto de perfil" />
        </div>

        <div class="ms-3 flex-grow-1">
            <div class="mb-2">
                <label asp-for="NombreArtistico" class="form-label">Nombre Artístico</label>
                <input asp-for="NombreArtistico" class="form-control" />
            </div>

            <div class="mb-2">
                <label asp-for="Biografia" class="form-label">Biografía</label>
                <textarea asp-for="Biografia" class="form-control" rows="4"></textarea>
            </div>

            <div class="mb-2">
                <label asp-for="UrlFotoPerfil" class="form-label">URL Foto de Perfil</label>
                <input asp-for="UrlFotoPerfil" class="form-control" placeholder="https://..." />
            </div>

            <div class="mb-2">
                <label asp-for="UrlFotoPortada" class="form-label">URL Foto de Portada</label>
                <input asp-for="UrlFotoPortada" class="form-control" placeholder="https://..." />
            </div>
        </div>
    </div>

    <button class="btn btn-success">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
